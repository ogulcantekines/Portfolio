# Copy this to .env.test to run the test suite locally against an isolated database.
# Uses a separate "portfolio_test" database on the same local Postgres so tests
# never touch your development data. Create it once with:
#   pnpm --filter @portfolio/backend exec dotenv -e .env.test -- prisma db push
NODE_ENV=test
DATABASE_URL="postgresql://portfolio:portfolio_dev@localhost:5432/portfolio_test"
JWT_SECRET="test-secret-value-with-enough-variety-1234567890"
ADMIN_PASSWORD="test-admin-password"
LOG_LEVEL="fatal"
