PORT=5000

# Must match the credentials in docker-compose.yml (portfolio / portfolio_dev)
DATABASE_URL="postgresql://portfolio:portfolio_dev@localhost:5432/portfolio"

FRONTEND_URL="http://localhost:3000"

# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET="change-this-in-production"

# Password for the /admin panel login
ADMIN_PASSWORD="change-this-in-production"
