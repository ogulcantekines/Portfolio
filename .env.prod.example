# Copy this file to .env.prod and fill in real values. NEVER commit .env.prod.
# Load it explicitly when bringing the stack up:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- PostgreSQL -------------------------------------------------------------
# Keep the password free of URL-special chars (@ : / ?) or DATABASE_URL breaks.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=portfolio

# --- Backend ----------------------------------------------------------------
# Signs JWTs. Generate a strong value: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
# Password for the /admin panel login.
ADMIN_PASSWORD=change-me-admin-password
# Public site origin, used for CORS. Phase A local test: http://localhost
FRONTEND_URL=http://localhost

# --- Frontend ---------------------------------------------------------------
# Baked into the browser bundle at BUILD time. Leave EMPTY so the browser calls
# same-origin /api/* (nginx proxies to backend) — no CORS, backend stays private.
NEXT_PUBLIC_API_URL=

# Public site URL for sitemap/robots/OG metadata (SEO). Baked into the bundle at
# build time. Set to the real domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
